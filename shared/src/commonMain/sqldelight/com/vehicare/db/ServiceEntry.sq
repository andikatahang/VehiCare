-- WAL is deliberately NOT set in this file: every unlabeled statement here is replayed inside
-- the generated Schema.create() through driver.execute(), and `PRAGMA journal_mode=wal` returns
-- a row — which the SQLiter non-query path rejects, aborting the first launch on iOS. The driver
-- factories establish WAL on the first connection instead (see com.vehicare.data.db.DriverFactory).

CREATE TABLE service_entry (
    id                    INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    vehicle_id            INTEGER NOT NULL REFERENCES vehicle(id),
    service_date_epoch_ms INTEGER NOT NULL,   -- UTC start-of-day millis of the civil date
    mileage_km            INTEGER NOT NULL,   -- unit in the name (PITFALLS SQL 2)
    service_type          TEXT    NOT NULL,   -- stable plain string (D-10/D-40); position-0 mirror of service_entry_type.label
    cost_rupiah           INTEGER,            -- whole rupiah, never floating point (D-29)
    notes                 TEXT,
    workshop              TEXT,
    mechanic              TEXT
);

CREATE TABLE service_part (
    id       INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    entry_id INTEGER NOT NULL REFERENCES service_entry(id),
    name     TEXT    NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    position INTEGER NOT NULL
);

CREATE TABLE service_photo (
    id         INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    entry_id   INTEGER NOT NULL REFERENCES service_entry(id),
    photo_path TEXT    NOT NULL,   -- relative path only (D-05/D-37)
    position   INTEGER NOT NULL
);

-- The child table is the source of truth for an entry's service types, ordered by `position`.
-- `service_entry.service_type` stays as a NOT NULL mirror of position 0: Android API 26 ships
-- SQLite 3.18, where `ALTER TABLE … DROP COLUMN` (3.35+) does not exist, and rebuilding the table
-- through `ALTER TABLE … RENAME` rewrites its `sqlite_master` SQL (the name gets quoted) and fails
-- the byte-identical migration verify — so writers keep the mirror in sync instead of dropping it.
-- `ON DELETE CASCADE` documents intent only: foreign keys are never enabled (no
-- `PRAGMA foreign_keys=ON` anywhere), so the explicit delete queries below are what remove rows.
-- The composite primary key is the only index this table needs — `WHERE entry_id = ?` is a prefix
-- lookup and the autoindex orders `(entry_id, position)`, so no extra CREATE INDEX is added.
CREATE TABLE service_entry_type (
    entry_id INTEGER NOT NULL REFERENCES service_entry(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    label    TEXT    NOT NULL,
    PRIMARY KEY (entry_id, position)
);

CREATE INDEX service_entry_vehicle_date    ON service_entry(vehicle_id, service_date_epoch_ms DESC, id DESC);
CREATE INDEX service_entry_vehicle_mileage ON service_entry(vehicle_id, mileage_km DESC);
CREATE INDEX service_part_entry            ON service_part(entry_id, position);
CREATE INDEX service_photo_entry           ON service_photo(entry_id, position);

selectForVehicleByDate:
SELECT * FROM service_entry WHERE vehicle_id = ?
ORDER BY service_date_epoch_ms DESC, id DESC;

selectForVehicleByMileage:
SELECT * FROM service_entry WHERE vehicle_id = ?
ORDER BY mileage_km DESC, service_date_epoch_ms DESC, id DESC;

selectById:
SELECT * FROM service_entry WHERE id = ?;

selectParts:
SELECT * FROM service_part WHERE entry_id = ? ORDER BY position;

selectPhotos:
SELECT * FROM service_photo WHERE entry_id = ? ORDER BY position;

selectTypes:
SELECT label FROM service_entry_type WHERE entry_id = ? ORDER BY position;

selectTypesForVehicle:
SELECT entry_id, label FROM service_entry_type
WHERE entry_id IN (SELECT id FROM service_entry WHERE vehicle_id = ?)
ORDER BY entry_id, position;

selectLatestMileage:
SELECT mileage_km FROM service_entry WHERE vehicle_id = ?
ORDER BY service_date_epoch_ms DESC, id DESC LIMIT 1;

selectPreviousMileage:
SELECT mileage_km FROM service_entry WHERE vehicle_id = ? AND id != ?
  AND (service_date_epoch_ms < ? OR (service_date_epoch_ms = ? AND id < ?))
ORDER BY service_date_epoch_ms DESC, id DESC LIMIT 1;

selectSummary:
SELECT COUNT(*) AS entry_count, MAX(service_date_epoch_ms) AS last_service_epoch_ms
FROM service_entry WHERE vehicle_id = ?;

-- One row per case-insensitive label, newest-used first. The bare `label` is well defined because
-- with exactly one MAX() aggregate SQLite takes bare columns from the row that supplied the
-- maximum; the old `WHERE entry_id IN (SELECT MAX(id) …)` shape would emit the same label twice
-- once a single entry carries several labels, and this SQLite version has no window functions.
selectLearnedTypes:
SELECT label, MAX(entry_id) AS last_used_id
FROM service_entry_type
GROUP BY lower(label)
ORDER BY last_used_id DESC;

insertEntry:
INSERT INTO service_entry(vehicle_id, service_date_epoch_ms, mileage_km, service_type, cost_rupiah, notes, workshop, mechanic)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateEntry:
UPDATE service_entry SET service_date_epoch_ms=?, mileage_km=?, service_type=?, cost_rupiah=?, notes=?, workshop=?, mechanic=?
WHERE id=?;

insertPart:
INSERT INTO service_part(entry_id, name, quantity, position) VALUES (?, ?, ?, ?);

insertPhoto:
INSERT INTO service_photo(entry_id, photo_path, position) VALUES (?, ?, ?);

insertEntryType:
INSERT INTO service_entry_type(entry_id, position, label) VALUES (?, ?, ?);

deletePartsForEntry:
DELETE FROM service_part WHERE entry_id = ?;

deletePhotosForEntry:
DELETE FROM service_photo WHERE entry_id = ?;

deleteTypesForEntry:
DELETE FROM service_entry_type WHERE entry_id = ?;

deleteEntry:
DELETE FROM service_entry WHERE id = ?;

-- Vehicle cascade (D-39) — order matters: collect paths before deleting rows
selectPhotoPathsForVehicle:
SELECT photo_path FROM service_photo
WHERE entry_id IN (SELECT id FROM service_entry WHERE vehicle_id = ?);

deletePhotosForVehicle:
DELETE FROM service_photo WHERE entry_id IN (SELECT id FROM service_entry WHERE vehicle_id = ?);

deletePartsForVehicle:
DELETE FROM service_part WHERE entry_id IN (SELECT id FROM service_entry WHERE vehicle_id = ?);

deleteTypesForVehicle:
DELETE FROM service_entry_type WHERE entry_id IN (SELECT id FROM service_entry WHERE vehicle_id = ?);

deleteEntriesForVehicle:
DELETE FROM service_entry WHERE vehicle_id = ?;

lastInsertId:
SELECT last_insert_rowid();
